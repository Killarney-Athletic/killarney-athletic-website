---
import clubCrestUrl from '../../assets/images/brand/crest/svg/Club Crest Default.svg?url';
import { withBase } from '../../utils/paths';
import { hasRoundTeamCrest, localCrestForTeam } from '../../utils/teamCrests';

interface Props {
  team: string;
  src?: string | null;
  size?: number;
}

const { team, src, size = 36 } = Astro.props as Props;
const isAthletic = /killarney\s+athletic/i.test(team);
const crest = isAthletic ? clubCrestUrl : localCrestForTeam(team) ?? src;
---

<span class:list={['team-crest', { 'team-crest--athletic': isAthletic, 'team-crest--missing': !crest }]} aria-hidden="true" style={`--team-crest-size:${size}px`}>
  {crest ? <img class:list={{ 'club-crest--round': hasRoundTeamCrest(team) }} src={withBase(crest)} alt="" width={size} height={size} loading="lazy" /> : '?'}
</span>

<style>
  .team-crest { display:grid; width:var(--team-crest-size); height:var(--team-crest-size); align-self:center; flex:0 0 auto; line-height:1; place-items:center; }
  .team-crest img { display:block; width:100%; height:100%; object-fit:contain; object-position:center; }
  .team-crest--athletic { transform:translateY(-4px); }
  .team-crest--missing { border:1px dashed rgb(16 23 32 / 24%); border-radius:50%; color:rgb(16 23 32 / 48%); font-size:.8rem; font-weight:700; }
</style>
