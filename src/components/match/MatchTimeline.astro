---
import { ArrowDownRight, ArrowUpRight, Volleyball } from '@lucide/astro';
interface Props { demo?: boolean; }
const { demo = false } = Astro.props as Props;
---
<section data-panel="timeline" aria-label="Match timeline">
  <ol class="match-timeline" data-timeline>
    {demo && <><li class="timeline__event timeline__event--home"><time>34'</time><div class="timeline__team-event timeline__team-event--home"><span class="timeline__names"><strong>J. Cooper</strong></span><span class="timeline__marker"><Volleyball /></span></div><b class="timeline__score">1 – 0</b><div></div></li><li class="timeline__period"><strong>HT</strong><b>1 – 0</b></li><li class="timeline__event timeline__event--away"><time>62'</time><div></div><b class="timeline__score"></b><div class="timeline__team-event timeline__team-event--away"><span class="timeline__marker timeline__marker--substitution"><ArrowUpRight class="timeline__sub-in"/><ArrowDownRight class="timeline__sub-out"/></span><span class="timeline__names"><strong>D. Feehan</strong><small>D. McCarthy</small></span></div></li></>}
  </ol>
  <div class="match-empty" data-no-events hidden><svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><strong data-no-events-title></strong><span data-no-events-detail></span></div>
</section>
<style>
  section{padding:1.25rem;border:1px solid var(--card-border);border-radius:var(--card-radius);background:white;box-shadow:var(--card-shadow)}.match-timeline{display:block;overflow:hidden;margin:0;padding:0;border:1px solid var(--line);border-radius:.65rem;color:var(--ink);background:var(--card-background-muted);list-style:none}.match-timeline :global(.timeline__event){display:grid;grid-template-columns:3.25rem minmax(0,1fr) 3.75rem minmax(0,1fr);align-items:center;width:100%;min-height:4rem;padding:.55rem 1rem;border-bottom:1px solid var(--line)}.match-timeline :global(.timeline__event time){color:var(--muted);font-size:.78rem;font-variant-numeric:tabular-nums}.match-timeline :global(.timeline__team-event){display:flex;align-items:center;gap:.55rem;min-width:0}.match-timeline :global(.timeline__team-event--home){justify-content:flex-end;text-align:right}.match-timeline :global(.timeline__team-event--away){justify-content:flex-start;text-align:left}.match-timeline :global(.timeline__names){display:grid;min-width:0;color:var(--ink);font-size:.78rem;line-height:1.25}.match-timeline :global(.timeline__names strong),.match-timeline :global(.timeline__names small){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.match-timeline :global(.timeline__names small){color:var(--muted);font-size:.72rem}.match-timeline :global(.timeline__score){justify-self:center;color:var(--brand-navy);font-size:.82rem;font-variant-numeric:tabular-nums;white-space:nowrap}.match-timeline :global(.timeline__marker){display:grid;flex:0 0 auto;width:1rem;height:1rem;place-items:center;color:var(--brand-navy)}.match-timeline :global(.timeline__marker svg){display:block;width:.9rem;height:.9rem}.match-timeline :global(.timeline__marker--substitution){grid-template-rows:1fr 1fr;height:2rem}.match-timeline :global(.timeline__marker--substitution svg){stroke-width:3}.match-timeline :global(.timeline__sub-in){color:#22c55e}.match-timeline :global(.timeline__sub-out){color:#e61c64}.match-timeline :global(.timeline__period){display:grid;grid-template-columns:3.25rem 1fr 3.75rem 1fr;align-items:center;width:100%;min-height:2.8rem;padding:.4rem 1rem;border-bottom:1px solid var(--line);color:var(--brand-navy);background:#eef1f5}.match-timeline :global(.timeline__period strong){grid-column:1;color:var(--muted);font-size:.75rem}.match-timeline :global(.timeline__period b){grid-column:3;justify-self:center;font-size:.8rem}.match-timeline>li:last-child{border-bottom:0}.match-timeline[hidden]{display:none}.match-empty{display:grid;justify-items:center;gap:.5rem;padding:clamp(2rem,6vw,3.5rem) 1.25rem;border:1px solid var(--line);border-radius:.75rem;text-align:center;background:var(--card-background-muted)}.match-empty[hidden]{display:none}.match-empty svg{width:2rem;height:2rem;margin-bottom:.25rem;fill:none;stroke:var(--brand-royal);stroke-width:1.7}.match-empty strong{color:var(--brand-navy);font-size:clamp(1rem,2vw,1.15rem);font-weight:500}.match-empty span{max-width:34rem;color:var(--muted);font-size:.86rem;font-weight:300}
  @media(max-width:640px){section{padding:.8rem}}
</style>
