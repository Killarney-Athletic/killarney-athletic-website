---
import { Volleyball } from '@lucide/astro';
interface Scorer { name: string; minutes: string[]; }
interface Props { teamLabel?: string; competition?: string; homeTeam?: string; awayTeam?: string; homeCrest?: string; awayCrest?: string; score?: string; status?: string; when?: string; venue?: string; homeScorers?: Scorer[]; awayScorers?: Scorer[]; }
const { teamLabel = '', competition = '', homeTeam = '', awayTeam = '', homeCrest = '', awayCrest = '', score = '', status = '', when = '', venue = '', homeScorers = [], awayScorers = [] } = Astro.props as Props;
---
<section class="scoreboard-concept match-centre__scoreboard">
  <div class="scoreboard-concept__frame">
    <img class="scoreboard-concept__watermark scoreboard-concept__watermark--home" data-home-watermark src={homeCrest || undefined} alt="" aria-hidden="true" />
    <img class="scoreboard-concept__watermark scoreboard-concept__watermark--away" data-away-watermark src={awayCrest || undefined} alt="" aria-hidden="true" />
    <header class="scoreboard-concept__meta">
      <p><span class="scoreboard-concept__cross" aria-hidden="true">+</span><span><strong data-scoreboard-team>{teamLabel}</strong><span data-scoreboard-separator hidden={!teamLabel}> - </span><span data-competition>{competition}</span></span></p>
      <p class="scoreboard-concept__when"><span><span data-when>{when}</span> · <span data-venue>{venue}</span></span><span class="scoreboard-concept__cross" aria-hidden="true">+</span></p>
    </header>
    <div class="scoreboard-concept__match">
      <div class="scoreboard-concept__team"><img data-home-crest src={homeCrest || undefined} alt="" width="120" height="120" /><h3 data-home-team>{homeTeam}</h3></div>
      <div class="scoreboard-concept__score"><strong data-score>{score.replace(/\s*[–—-]\s*/g, ' - ')}</strong><span data-status>{status}</span></div>
      <div class="scoreboard-concept__team"><img data-away-crest src={awayCrest || undefined} alt="" width="120" height="120" /><h3 data-away-team>{awayTeam}</h3></div>
    </div>
    <div hidden={!homeScorers.length && !awayScorers.length} data-scoreboard-scorers class="scoreboard-concept__scorers" role="group" aria-label="Goalscorers">
      <ul class="scoreboard-concept__scorers-home" data-home-scorers aria-label="Home goalscorers">{homeScorers.map(scorer => <li><span>{scorer.name}</span> <span class="scoreboard-concept__minutes">{scorer.minutes.map(minute => `${minute}′`).join(', ')}</span></li>)}</ul>
      <div class="scoreboard-concept__scorer-middle" aria-hidden="true"><Volleyball size={24} /></div>
      <ul class="scoreboard-concept__scorers-away" data-away-scorers aria-label="Away goalscorers">{awayScorers.map(scorer => <li><span>{scorer.name}</span> <span class="scoreboard-concept__minutes">{scorer.minutes.map(minute => `${minute}′`).join(', ')}</span></li>)}</ul>
    </div>
    <footer aria-hidden="true"><span>+</span><span>+</span><span>+</span></footer>
  </div>
</section>
<style>
  .scoreboard-concept { --score-middle-width:clamp(6.5rem,24vw,17rem); padding:0; background:transparent; border-radius:12px; }
  .scoreboard-concept__frame { position:relative; isolation:isolate; overflow:hidden; border:3px solid transparent; border-radius:12px; color:white; background:linear-gradient(90deg,var(--team-left-colour,#09204d) 0%,var(--team-left-colour,#09204d) 25%,var(--team-right-colour,#0e483a) 75%,var(--team-right-colour,#0e483a) 100%) padding-box,linear-gradient(90deg,var(--team-left-colour,#09204d) 0%,var(--team-left-colour,#09204d) 25%,var(--team-right-colour,#0e483a) 75%,var(--team-right-colour,#0e483a) 100%) border-box; box-shadow:inset 0 0 0 3px rgb(255 255 255 / 4%); }
  .scoreboard-concept__frame::before { content:''; position:absolute; inset:0; z-index:-1; background:radial-gradient(circle,rgb(0 0 0 / 28%) .7px,transparent 1px); background-size:4px 4px; pointer-events:none; }
  .scoreboard-concept__watermark { position:absolute; z-index:-1; width:40%; height:95%; object-fit:contain; top:15%; opacity:.05; filter:grayscale(1); pointer-events:none; }
  .scoreboard-concept__watermark--home { left:-13%; transform:rotate(-12deg) scale(1.3); }
  .scoreboard-concept__watermark--away { right:-12%; transform:rotate(12deg) scale(1.3); }
  .scoreboard-concept__meta { display:flex; justify-content:space-between; align-items:center; gap:2rem; padding:1.1rem 1.2rem; background:transparent; font-size:.78rem; letter-spacing:normal; line-height:1.5; }
  .scoreboard-concept__meta p { display:flex; align-items:center; gap:.75rem; margin:0; }
  .scoreboard-concept__meta p:first-child { display:flex; align-items:center; gap:.75rem; max-width:70%; }
  .scoreboard-concept__meta strong { font-weight:700; }
  .scoreboard-concept__cross { position:relative; display:block; flex:0 0 1rem; width:1rem; height:1rem; font-size:0; transform:translateY(-1px); opacity:.6; }
  .scoreboard-concept__cross::before, .scoreboard-concept__cross::after { content:''; position:absolute; top:50%; left:50%; background:currentColor; transform:translate(-50%,-50%); }
  .scoreboard-concept__cross::before { width:12px; height:1px; }
  .scoreboard-concept__cross::after { width:1px; height:12px; }
  .scoreboard-concept__when { flex:0 1 auto; display:flex; align-items:center; gap:.75rem; text-align:right; }
  .scoreboard-concept__match { display:grid; grid-template-columns:minmax(0,1fr) var(--score-middle-width) minmax(0,1fr); align-items:center; gap:1.5rem; padding:3.5rem 2rem 2.75rem; }
  .scoreboard-concept__team { display:grid; justify-items:center; gap:1.1rem; text-align:center; }
  .scoreboard-concept__team img { width:clamp(75px,10vw,120px); height:clamp(75px,10vw,120px); object-fit:contain; filter:drop-shadow(0 4px 4px #0007); }
  .scoreboard-concept__team h3 { margin:0; color:white; font-family:inherit; font-size:clamp(.8rem,2.2vw,1.45rem); font-weight:500; line-height:1.25; }
  .scoreboard-concept__score { align-self:start; display:grid; justify-items:center; gap:.5rem; padding-top:.2rem; }
  .scoreboard-concept__score strong { font-family:var(--font-score); font-size:clamp(3rem,10vw,7.5rem); font-weight:700; font-style:normal; white-space:nowrap; line-height:1.15; letter-spacing:-.03em; text-shadow:none; }
  .scoreboard-concept__score span { font-size:.8rem; text-transform:uppercase; letter-spacing:.05em; }
  .scoreboard-concept__scorers { display:grid; grid-template-columns:minmax(0,1fr) 28px minmax(0,1fr); align-items:start; gap:1.25rem; padding:1.2rem 2rem; background:transparent; border:0; }
  .scoreboard-concept__scorers[hidden] { display:none; }
  .scoreboard-concept__scorers ul { margin:0; padding:0; list-style:none; font-size:clamp(.7rem,1.3vw,.875rem); line-height:1.7; }
  .scoreboard-concept__scorers-home { text-align:right; }
  .scoreboard-concept__scorers-away { text-align:left; }
  .scoreboard-concept__minutes { opacity:.8; font-variant-numeric:tabular-nums; white-space:nowrap; }
  .scoreboard-concept__scorer-middle { display:grid; justify-items:center; }
  .scoreboard-concept__scorer-middle svg { margin-top:.25rem; opacity:.7; }
  @media(max-width:600px) { .scoreboard-concept__scorers { gap:.5rem; padding:1rem .65rem; } }
  footer { display:flex; justify-content:space-between; padding:.2rem 1.2rem 1rem; font-size:1.6rem; font-weight:200; opacity:.55; }
  @media (max-width:600px) { .scoreboard-concept__meta { flex-direction:column; align-items:stretch; padding:.85rem; gap:.75rem; font-size:.55rem; } .scoreboard-concept__meta p:first-child { max-width:none; } .scoreboard-concept__cross { display:none; } .scoreboard-concept__match { gap:.5rem; padding:2rem .65rem; } .scoreboard-concept__team img { width:64px; height:64px; } .scoreboard-concept__score span { font-size:.6rem; } .scoreboard-concept__score strong { font-size:clamp(2.2rem,10vw,4rem); } }
</style>
