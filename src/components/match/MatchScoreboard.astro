---
interface Props { competition?: string; homeTeam?: string; awayTeam?: string; homeCrest?: string; awayCrest?: string; score?: string; status?: string; when?: string; venue?: string; }
const { competition = '', homeTeam = '', awayTeam = '', homeCrest = '', awayCrest = '', score = '', status = '', when = '', venue = '' } = Astro.props as Props;
---
<header class="match-centre__scoreboard">
  <p class="match-centre__competition" data-competition>{competition}</p>
  <div class="match-centre__teams">
    <div class="match-centre__team"><img data-home-crest src={homeCrest || undefined} alt="" /><h1 data-home-team>{homeTeam}</h1></div>
    <div class="match-centre__score"><strong data-score>{score}</strong><span data-status>{status}</span></div>
    <div class="match-centre__team"><img data-away-crest src={awayCrest || undefined} alt="" /><h1 data-away-team>{awayTeam}</h1></div>
  </div>
  <p data-when>{when}</p><p data-venue>{venue}</p>
</header>

<style>
  .match-centre__scoreboard{padding:clamp(1.5rem,4vw,3rem);border-radius:var(--card-radius);color:white;text-align:center;background:linear-gradient(115deg,var(--team-left-colour,var(--brand-navy)) 0%,var(--brand-royal) 50%,var(--team-right-colour,#344054) 100%);box-shadow:var(--card-shadow)}
  .match-centre__competition{margin:0 0 1.5rem;opacity:.8}.match-centre__teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:clamp(1rem,4vw,3rem)}.match-centre__team{display:grid;justify-items:center;gap:.75rem}.match-centre__team img{width:clamp(64px,10vw,108px);height:clamp(64px,10vw,108px);object-fit:contain}.match-centre__team h1{margin:0;color:white;font-size:clamp(1rem,2.4vw,1.5rem)}.match-centre__score{display:grid;gap:.35rem}.match-centre__score strong{font-family:"Oleo Script Swash Caps",ui-serif,Georgia,serif;font-size:clamp(2rem,6vw,4rem);white-space:nowrap}.match-centre__score span{font-size:.75rem;opacity:.8;text-transform:uppercase;letter-spacing:.08em}.match-centre__scoreboard>p:last-child{margin-bottom:0}.match-centre__scoreboard [data-when],.match-centre__scoreboard [data-venue]{opacity:.72;font-size:clamp(.72rem,1.4vw,.88rem);font-weight:300;line-height:1.35}
  @media(max-width:640px){.match-centre__scoreboard{padding:1.35rem 1rem 1.5rem}.match-centre__competition{margin-bottom:1.25rem}.match-centre__teams{grid-template-columns:minmax(0,1fr) 4.25rem minmax(0,1fr);gap:.35rem}.match-centre__team{gap:.45rem}.match-centre__team img{width:54px;height:54px}.match-centre__team h1{font-size:.78rem;font-weight:400;line-height:1.25}.match-centre__score strong{font-size:2rem}.match-centre__score span{font-size:.62rem}.match-centre__scoreboard [data-when]{margin:1.2rem 0 0}.match-centre__scoreboard [data-venue]{margin:.25rem 0 0}}
</style>
