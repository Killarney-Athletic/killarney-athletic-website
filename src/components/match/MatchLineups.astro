---
interface Props { demo?: boolean; }
const { demo = false } = Astro.props as Props;
const players = [{n:1,name:'C. Mitchell',pos:'GK'},{n:8,name:"B. O'Shea",pos:'CM'},{n:11,name:'J. Bowler',pos:'CF'}];
---
<div class="lineups"><div><h3 data-home-lineup-title>{demo ? 'Killarney Athletic A.F.C.' : ''}</h3><div data-home-lineup>{demo && <ol class="lineup-list">{players.map(p=><li><span>{p.n}</span><div class="lineup-player"><strong>{p.name}</strong></div><small>{p.pos}</small></li>)}</ol>}</div></div><div><h3 data-away-lineup-title>{demo ? 'Opposition A' : ''}</h3><div data-away-lineup>{demo && <ol class="lineup-list">{players.map(p=><li><span>{p.n}</span><div class="lineup-player"><strong>{p.name}</strong></div><small>{p.pos}</small></li>)}</ol>}</div></div></div><p data-no-lineups hidden>Line-ups have not been published for this match.</p>
<style>
  .lineups{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.lineups>div{padding:1rem;border:1px solid var(--line);border-radius:.75rem}.lineups>div>h3{margin:-1rem -1rem .35rem;padding:1rem;border-bottom:1px solid var(--line);border-radius:.75rem .75rem 0 0;color:var(--brand-navy);background:var(--card-background-muted);font-size:1rem}.lineups :global(.lineup-list){display:grid;gap:.35rem;padding:0;list-style:none}.lineups :global(.lineup-list li){display:grid;grid-template-columns:2rem minmax(0,1fr) auto;align-items:center;gap:.6rem;min-height:3.15rem;padding:.55rem;border-bottom:1px solid var(--line)}.lineups :global(.lineup-list small){color:var(--muted)}.lineups :global(.lineup-player){display:flex;align-items:center;flex-wrap:wrap;gap:.4rem .6rem;min-width:0}.lineups :global(.lineup-player>strong){text-transform:none}.lineups :global(.lineup-player__events){display:inline-flex;align-items:center;flex-wrap:wrap;gap:.3rem}.lineups :global(.lineup-event){display:inline-flex;align-items:center;gap:.2rem;min-height:1.35rem;padding:.15rem .38rem;border-radius:999px;font-size:.68rem;font-weight:750;font-variant-numeric:tabular-nums;line-height:1}.lineups :global(.lineup-event svg){width:.72rem;height:.72rem;stroke-width:2.4}.lineups :global(.lineup-event--goal){color:#17202c;background:#eef1f4}.lineups :global(.lineup-event--sub-in){color:#15803d;background:#dcfce7}.lineups :global(.lineup-event--sub-out){color:#be185d;background:#fce7f3}.lineups :global(.lineup-event--yellow),.lineups :global(.lineup-event--red){position:relative;padding-left:1rem}.lineups :global(.lineup-event--yellow)::before,.lineups :global(.lineup-event--red)::before{position:absolute;left:.38rem;width:.38rem;height:.72rem;border-radius:.06rem;content:""}.lineups :global(.lineup-event--yellow){color:#665f00;background:#fffbd1}.lineups :global(.lineup-event--yellow)::before{background:#e6df00}.lineups :global(.lineup-event--red){color:#a31624;background:#ffe1e4}.lineups :global(.lineup-event--red)::before{background:#ef3340}.lineups :global(h4){margin:1rem 0 0;padding:.8rem 0 .25rem;color:var(--brand-navy);font-size:.82rem;text-transform:uppercase;letter-spacing:.06em}
  @media(max-width:640px){.lineups{grid-template-columns:1fr}}
</style>
