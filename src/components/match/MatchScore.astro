---
interface Props {
  value?: number | null;
  winning?: boolean;
}

const { value = null, winning = false } = Astro.props as Props;
---

<span class:list={['match-score', { 'match-score--winner': winning }]} aria-hidden="true">
  {value ?? '–'}
</span>

<style>
  .match-score { display:block; width:2rem; color:var(--muted); font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace; font-size:.95rem; font-variant-numeric:tabular-nums; font-weight:500; text-align:center; }
  .match-score--winner { color:var(--brand-navy); font-weight:800; }
</style>
