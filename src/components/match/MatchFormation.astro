---
import clubCrestWhiteUrl from '../../assets/images/brand/Club Crest White.svg?url';
interface Props { demo?: boolean; }
const { demo = false } = Astro.props as Props;
---
<div class="formation-pitch" data-pitch role="group" aria-label="Starting formations">
  <svg class="formation-pitch__lines" viewBox="0 0 680 1040" preserveAspectRatio="none" aria-hidden="true"><rect x="18" y="18" width="644" height="1004" rx="18"/><line x1="18" y1="520" x2="662" y2="520"/><circle cx="340" cy="520" r="92"/><circle cx="340" cy="520" r="4"/><rect x="155" y="18" width="370" height="150"/><rect x="245" y="18" width="190" height="62"/><circle cx="340" cy="120" r="4"/><path d="M270 168a78 78 0 0 0 140 0"/><rect x="155" y="872" width="370" height="150"/><rect x="245" y="960" width="190" height="62"/><circle cx="340" cy="920" r="4"/><path d="M270 872a78 78 0 0 1 140 0"/></svg>
  <img class="formation-pitch__watermark formation-pitch__watermark--home" data-pitch-home-crest src={demo ? clubCrestWhiteUrl : undefined} alt=""/><img class="formation-pitch__watermark formation-pitch__watermark--away" data-pitch-away-crest src={demo ? clubCrestWhiteUrl : undefined} alt=""/>
  <div class="formation-pitch__identity formation-pitch__identity--home"><img data-pitch-home-badge-crest src={demo ? clubCrestWhiteUrl : undefined} alt=""/><strong data-pitch-home-formation>{demo ? '4-3-3' : ''}</strong></div>
  <div class="formation-pitch__identity formation-pitch__identity--away"><img data-pitch-away-badge-crest src={demo ? clubCrestWhiteUrl : undefined} alt=""/><strong data-pitch-away-formation>{demo ? '4-4-2' : ''}</strong></div>
  <div class="formation-pitch__players" data-pitch-players role="list">{demo && <><div class="pitch-player" style="--player-x:50%;--player-y:15%;--team-colour:#4169e1"><span class="pitch-player__number">1</span><strong>J. Cooper</strong></div><div class="pitch-player" style="--player-x:30%;--player-y:35%;--team-colour:#4169e1"><span class="pitch-player__number">4</span><strong>D. Murphy (C)</strong></div><div class="pitch-player" style="--player-x:70%;--player-y:65%;--team-colour:#60c49a"><span class="pitch-player__number">9</span><strong>T. Sparling</strong></div></>}</div>
</div>
<style>
  .formation-pitch{position:relative;isolation:isolate;width:min(100%,680px);aspect-ratio:680/1040;margin:1rem auto 2rem;overflow:hidden;border-radius:1.25rem;background:linear-gradient(rgb(4 48 31/.93),rgb(7 62 39/.96));box-shadow:0 18px 44px rgb(3 32 22/.22)}.formation-pitch__lines{position:absolute;z-index:1;inset:0;width:100%;height:100%;fill:none;stroke:rgb(255 255 255/.19);stroke-width:3}.formation-pitch__watermark{position:absolute;z-index:0;width:45%;height:35%;object-fit:contain;opacity:.055}.formation-pitch__watermark--home{top:9%;right:-7%}.formation-pitch__watermark--away{bottom:9%;left:-7%}.formation-pitch__identity{position:absolute;z-index:5;display:grid;width:clamp(4.2rem,12vw,5.6rem);min-height:clamp(5rem,14vw,6.5rem);place-items:center;align-content:center;gap:.35rem;padding:.6rem;color:white;background:rgb(1 24 17/.92)}.formation-pitch__identity img{width:clamp(2rem,5.6vw,2.8rem);height:clamp(2rem,5.6vw,2.8rem);object-fit:contain}.formation-pitch__identity strong{font-size:clamp(.65rem,1.8vw,.9rem)}.formation-pitch__identity--home{top:0;left:0;border-radius:1.2rem 0 1.25rem}.formation-pitch__identity--away{right:0;bottom:0;border-radius:1.25rem 0 1.2rem}.formation-pitch__players{position:absolute;z-index:3;inset:0}.formation-pitch :global(.pitch-player){position:absolute;z-index:4;left:var(--player-x);top:var(--player-y);display:grid;width:clamp(3.6rem,13vw,6.5rem);justify-items:center;color:white;text-align:center;transform:translate(-50%,-50%)}.formation-pitch :global(.pitch-player__number){display:grid;width:clamp(2rem,6vw,2.75rem);height:clamp(2rem,6vw,2.75rem);place-items:center;border:2px solid rgb(255 255 255/.86);border-radius:50%;color:var(--team-ink,#fff);background:var(--team-colour,#52657d);font-weight:800}.formation-pitch :global(.pitch-player strong){margin-top:calc(.45rem + 2px);color:white;text-shadow:0 1px 3px #000;font-size:clamp(.56rem,1.6vw,.76rem)}.formation-pitch :global(.pitch-player__badges){position:absolute;z-index:2;inset:0}.formation-pitch :global(.pitch-badge){position:absolute;display:inline-flex;align-items:center;justify-content:center;border-radius:999px;font-weight:800;line-height:1;white-space:nowrap}.formation-pitch :global(.pitch-badge--goal){right:calc(50% + clamp(.25rem,.8vw,.38rem));justify-content:flex-end;gap:.12rem;padding:.13rem .2rem;color:#101720;background:rgb(255 255 255/.94)}.formation-pitch :global(.pitch-badge--sub){left:calc(50% + clamp(.25rem,.8vw,.38rem));gap:.12rem;padding:.18rem .28rem;color:white;background:#d81b60}.formation-pitch :global(.pitch-badge--goal),.formation-pitch :global(.pitch-badge--sub){--pitch-chip-height:clamp(1rem,2.65vw,1.2rem);top:calc(clamp(1.35rem,4vw,2rem) + clamp(.075rem,.275vw,.125rem) - 2px);height:var(--pitch-chip-height);font-size:clamp(.58rem,1.55vw,.74rem)}.formation-pitch :global(.pitch-badge--single-goal){width:var(--pitch-chip-height);padding:0;aspect-ratio:1;justify-content:center}.formation-pitch :global(.pitch-badge__goal-count:empty){display:none}.formation-pitch :global(.pitch-badge__ball),.formation-pitch :global(.pitch-badge__sub-arrow){display:inline-grid;place-items:center}.formation-pitch :global(.pitch-badge__ball svg){width:clamp(.62rem,1.65vw,.76rem);height:clamp(.62rem,1.65vw,.76rem)}.formation-pitch :global(.pitch-badge__sub-arrow svg){width:clamp(.7rem,1.85vw,.84rem);height:clamp(.7rem,1.85vw,.84rem)}.formation-pitch :global(.pitch-badge--yellow),.formation-pitch :global(.pitch-badge--red){top:-.12rem;left:calc(50% + clamp(.55rem,1.8vw,.85rem));width:clamp(.38rem,1.2vw,.52rem);height:clamp(.68rem,2vw,.9rem);border-radius:.08rem}.formation-pitch :global(.pitch-badge--yellow){background:#ffe500}.formation-pitch :global(.pitch-badge--red){background:#ef3340}
  @media(max-width:640px){
    .formation-pitch{width:100%;aspect-ratio:680/1120;margin:.5rem auto 1rem;border-radius:1rem}
    .formation-pitch__identity{width:3.6rem;min-height:4.25rem;gap:.2rem;padding:.4rem}
    .formation-pitch__identity img{width:1.7rem;height:1.7rem}
    .formation-pitch__identity strong{font-size:.58rem}
    .formation-pitch :global(.pitch-player){width:2.85rem}
    .formation-pitch :global(.pitch-player__number){width:1.72rem;height:1.72rem;border-width:1.5px;font-size:.66rem}
    .formation-pitch :global(.pitch-player strong){margin-top:.27rem;font-size:.43rem;line-height:1.05}
    .formation-pitch :global(.pitch-badge--goal),.formation-pitch :global(.pitch-badge--sub){--pitch-chip-height:.78rem;top:1.08rem;gap:.06rem;padding-inline:.14rem;font-size:.45rem}
    .formation-pitch :global(.pitch-badge__ball svg),.formation-pitch :global(.pitch-badge__sub-arrow svg){width:.52rem;height:.52rem}
    .formation-pitch :global(.pitch-badge--yellow),.formation-pitch :global(.pitch-badge--red){left:calc(50% + .42rem);width:.3rem;height:.58rem}
  }
</style>
