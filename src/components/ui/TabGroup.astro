---
interface TabItem {
  id: string;
  label: string;
  content?: string;
  href?: string;
}

interface Props {
  items: TabItem[];
  activeId?: string;
  ariaLabel?: string;
  class?: string;
}

const {
  items,
  activeId = items[0]?.id,
  ariaLabel = 'Choose a section',
  class: className = '',
} = Astro.props;

const groupId = `tab-group-${crypto.randomUUID()}`;
const isNavigation = items.some((item) => item.href);
---

<div class:list={['ui-tab-group', className]} data-tab-group>
  <div class="ui-tab-group__scroller">
    <div class="tabs tabs-border tabs-md" role={isNavigation ? undefined : 'tablist'} aria-label={ariaLabel}>
      {items.map((item) => {
        const isActive = item.id === activeId;
        return item.href ? (
          <a
            class="tab"
            href={item.href}
            aria-current={isActive ? 'page' : undefined}
          >
            {item.label}
          </a>
        ) : (
          <button
            class="tab"
            id={`${groupId}-tab-${item.id}`}
            type="button"
            role="tab"
            aria-selected={isActive ? 'true' : 'false'}
            aria-controls={`${groupId}-panel-${item.id}`}
            tabindex={isActive ? 0 : -1}
          >
            {item.label}
          </button>
        );
      })}
    </div>
  </div>

  {!isNavigation && items.map((item) => {
    const isActive = item.id === activeId;
    return (
      <div
        class="ui-tab-group__panel"
        id={`${groupId}-panel-${item.id}`}
        role="tabpanel"
        aria-labelledby={`${groupId}-tab-${item.id}`}
        tabindex="0"
        hidden={!isActive}
      >
        <p>{item.content}</p>
      </div>
    );
  })}
</div>

<script>
  const setupTabGroup = (group) => {
    if (!(group instanceof HTMLElement) || group.dataset.ready === 'true') return;
    group.dataset.ready = 'true';

    const tabs = Array.from(group.querySelectorAll('[role="tab"]'));
    const panels = Array.from(group.querySelectorAll('[role="tabpanel"]'));
    const isNavigation = panels.length === 0;

    const selectTab = (tab, focus = false) => {
      if (!(tab instanceof HTMLElement)) return;

      tabs.forEach((item) => {
        const isSelected = item === tab;
        item.setAttribute('aria-selected', String(isSelected));
        item.setAttribute('tabindex', isSelected ? '0' : '-1');
      });

      panels.forEach((panel) => {
        panel.toggleAttribute('hidden', panel.id !== tab.getAttribute('aria-controls'));
      });

      tab.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'nearest' });
      if (focus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      if (!isNavigation) tab.addEventListener('click', () => selectTab(tab));
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();

        const nextIndex = event.key === 'Home'
          ? 0
          : event.key === 'End'
            ? tabs.length - 1
            : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        const nextTab = tabs[nextIndex];
        if (isNavigation && nextTab instanceof HTMLAnchorElement) {
          nextTab.focus();
        } else {
          selectTab(nextTab, true);
        }
      });
    });
  };

  document.querySelectorAll('[data-tab-group]').forEach(setupTabGroup);
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-tab-group]').forEach(setupTabGroup);
  });
</script>
