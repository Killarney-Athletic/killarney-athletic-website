---
import { ArrowRight } from '@lucide/astro';
import Button from './Button.astro';
import ContentBadge from './ContentBadge.astro';

interface Props {
  title: string;
  href: string;
  excerpt?: string;
  category?: string;
  date?: Date | string;
  ctaLabel?: string;
  class?: string;
}

const {
  title,
  href,
  excerpt,
  category,
  date,
  ctaLabel = 'View',
  class: className = '',
} = Astro.props as Props;

const parsedDate = date ? new Date(date) : null;
const isValidDate = parsedDate && !Number.isNaN(parsedDate.getTime());
---

<article class:list={['listing-item', className]}>
  {(category || isValidDate) && (
    <div class="meta-row">
      {category && <ContentBadge label={category} />}
      {isValidDate && (
        <time datetime={parsedDate.toISOString()}>
          {parsedDate.toLocaleDateString('en-IE', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      )}
    </div>
  )}

  <h2>
    <a href={href}>{title}</a>
  </h2>

  {excerpt && <p>{excerpt}</p>}

  <Button
    class="listing-item__button"
    href={href}
    label={ctaLabel}
    size="sm"
    variant="primary"
    ariaLabel={`${ctaLabel}: ${title}`}
  >
    <ArrowRight slot="icon" size={16} stroke-width={2.4} />
  </Button>
</article>
