---
import FixtureCard from '../components/FixtureCard.astro';
import PageHeader from '../components/PageHeader.astro';
import PagePanel from '../components/PagePanel.astro';
import CarouselNavigation from '../components/CarouselNavigation.astro';
import LeagueTableHeader from '../components/LeagueTableHeader.astro';
import Layout from '../layouts/Layout.astro';
import { readFaiSnapshot } from '../lib/fai/data';
import { withBase } from '../utils/paths';

const data = await readFaiSnapshot();
const matches = data.matches
  .map((match) => ({ ...match, status: Date.parse(match.date) > Date.now() ? 'future' as const : 'past' as const }))
  .sort((a, b) => Date.parse(a.date) - Date.parse(b.date));
const formatDate = (value: string) => new Intl.DateTimeFormat('en-IE', { timeZone: 'Europe/Dublin', weekday: 'long', month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true }).format(new Date(value)).replace(' at ', ', ').replace('a.m.', 'am').replace('p.m.', 'pm');
const displayClubName = (value: string) => {
  if (/^Killarney Athletic AFC\b/i.test(value)) {
    const squad = value.match(/\b(Senior\s+[AB]|U\d{2}[A-Z]?)\b/i)?.[1];
    const squadLabel = squad?.match(/[AB]$/i)?.[0].toUpperCase();
    return `Killarney Athletic A.F.C.${squadLabel ? ` ${squadLabel}` : ''}`;
  }
  return value
    .replace(/\s+Senior\s+([AB])\b/i, ' $1')
    .replace(/\s+(?:Men|Mens|Women's|Women|Boys|Girls)\s+([AB])\b/i, ' $1')
    .replace(/\s+([AB])\s+Team\b/i, ' $1')
    .replace(/\s+KRYDL(?:\s+Premier A)?$/i, '')
    .replace(/\s+KDL\s+([AB])$/i, ' $1')
    .replace(/\s+(?:\d{2}\/\d{2}|20\d{2}\/\d{2}|20\d{2}-20\d{2})(?:\s+season)?$/i, '')
    .trim();
};
const updatedAt = new Intl.DateTimeFormat('en-IE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Dublin' }).format(new Date(data.sourceUpdatedAt));
---

<Layout title="Fixtures & Results | Killarney Athletic A.F.C." description="Fixtures, results and league tables for every Killarney Athletic A.F.C. team." canonicalPath="/fixtures-results/">
  <article class="page-shell page-template page-template--data fixtures-results-page">
    <PageHeader title="Fixtures & Results" intro="Fixtures, results and league information across Killarney Athletic A.F.C." breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Fixtures & Results' }]} />
    <div class="fai-toolbar">
      <label for="fixtures-team-filter">Team</label>
      <select id="fixtures-team-filter" class="select select-bordered" data-team-filter><option value="all">All teams</option>{data.teams.map((team) => <option value={team.id}>{team.label}</option>)}</select>
      <p>{data.isFallback ? 'Showing the latest saved update' : `Updated ${updatedAt}`}</p>
      <button class="btn btn-ghost fai-refresh" type="button" data-refresh><svg aria-hidden="true" viewBox="0 0 24 24"><path d="M21 12a9 9 0 0 1-15.3 6.4M3 12A9 9 0 0 1 18.3 5.6"/><path d="M21 4v6h-6M3 20v-6h6"/></svg> Refresh</button>
    </div>
    <p class="sr-only" aria-live="polite" data-live></p>
    <section class="match-section" aria-labelledby="matches-heading">
      <div class="carousel-heading"><div><p class="eyebrow" data-matches-context>All teams</p><h2 id="matches-heading">Matches</h2></div><CarouselNavigation /></div>
      <div class="match-carousel" data-carousel tabindex="0" aria-label="Fixtures and results">
        {matches.map((match) => <div class="match-carousel__item" data-match data-team={match.teamId} data-competition={match.competitionId} data-status={match.status} data-date={match.date}><FixtureCard matchId={String(match.id)} href={withBase(`/match-centre/${match.id}/`)} score={match.score ?? undefined} label={match.teamLabel} homeTeam={match.homeTeam} awayTeam={match.awayTeam} homeCrest={match.homeCrest} awayCrest={match.awayCrest} homeColour={match.homeColour} awayColour={match.awayColour} competition={match.competition} date={formatDate(match.date)} venue={match.venue} muted={match.status === 'past'} /></div>)}
        {!matches.length && <p>No match information is currently available.</p>}
        <span class="match-carousel__spacer" data-carousel-spacer aria-hidden="true"></span>
        <span class="match-carousel__spacer" data-carousel-spacer aria-hidden="true"></span>
      </div>
    </section>
    <section class="league-table-section" aria-labelledby="league-table-heading">
      <PagePanel class="league-table-shell" flush>
        <LeagueTableHeader slot="header" dynamic />
        <div class="overflow-x-auto">
          {data.tables.map((table) => <table class="table table-zebra league-table" data-table data-competition={table.competitionId} data-team-ids={table.teamIds.join(',')} hidden><caption class="sr-only">{table.competition} standings</caption><thead><tr><th>Pos</th><th>Club</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>GD</th><th>Pts</th></tr></thead><tbody>{table.rows.map((row) => <tr class:list={{ 'league-table__club-row': row.isKillarneyAthletic }}><td>{row.position}</td><th scope="row"><span class="league-table__club">{row.crestUrl ? <img src={withBase(row.crestUrl)} alt="" width="28" height="28" loading="lazy" /> : <span class="league-table__crest-placeholder"></span>}<span>{displayClubName(row.club)}</span></span></th><td>{row.played}</td><td>{row.won}</td><td>{row.drawn}</td><td>{row.lost}</td><td>{row.goalsFor}</td><td>{row.goalsAgainst}</td><td>{row.goalDifference}</td><td><strong>{row.points}</strong></td></tr>)}</tbody></table>)}
          <p class="table-empty" data-table-empty>Select a team to see its current league table.</p>
        </div>
      </PagePanel>
    </section>
  </article>
  <script>
    const filter = document.querySelector<HTMLSelectElement>('[data-team-filter]');
    const carousel = document.querySelector<HTMLElement>('[data-carousel]');
    const matchTime = (item: HTMLElement) => Date.parse(item.dataset.date ?? '');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-match]')).sort((a, b) => {
      const aTime = matchTime(a); const bTime = matchTime(b);
      if (!Number.isFinite(aTime)) return 1;
      if (!Number.isFinite(bTime)) return -1;
      return aTime - bTime;
    });
    const spacers = Array.from(document.querySelectorAll<HTMLElement>('[data-carousel-spacer]'));
    if (carousel) { items.forEach((item) => carousel.append(item)); spacers.forEach((spacer) => carousel.append(spacer)); }
    const tables = Array.from(document.querySelectorAll<HTMLTableElement>('[data-table]'));
    const empty = document.querySelector<HTMLElement>('[data-table-empty]');
    const heading = document.querySelector<HTMLElement>('[data-table-heading]');
    const matchesContext = document.querySelector<HTMLElement>('[data-matches-context]');
    const live = document.querySelector<HTMLElement>('[data-live]');
    const reset = (behavior: ScrollBehavior = 'smooth') => {
      const team = filter?.value ?? 'all';
      if (matchesContext) matchesContext.textContent = team === 'all' ? 'All teams' : filter?.selectedOptions[0]?.textContent?.trim() || 'Selected team';
      items.forEach((item) => item.hidden = team !== 'all' && item.dataset.team !== team);
      const visibleItems = items.filter((item) => !item.hidden);
      items.forEach((item) => { const badge = item.querySelector<HTMLElement>('[data-match-context]'); if (badge) { badge.hidden = true; badge.textContent = ''; } });
      const now = Date.now();
      const lastMatch = visibleItems.filter((item) => matchTime(item) <= now).at(-1);
      const nextMatch = visibleItems.find((item) => matchTime(item) > now);
      const setContextBadge = (item: HTMLElement | undefined, label: string) => { const badge = item?.querySelector<HTMLElement>('[data-match-context]'); if (badge) { badge.textContent = label; badge.hidden = false; } };
      setContextBadge(lastMatch, 'Last match'); setContextBadge(nextMatch, 'Next match');
      const startingMatch = lastMatch ?? nextMatch ?? visibleItems[0];
      if (carousel && startingMatch) requestAnimationFrame(() => carousel.scrollTo({ left: Math.max(0, startingMatch.offsetLeft - carousel.offsetLeft), behavior }));
      let shown = false;
      const firstCompetition = items.find((item) => !item.hidden)?.dataset.competition;
      const preferred = tables.find((table) => team !== 'all' && table.dataset.competition === firstCompetition) ?? tables.find((table) => team !== 'all' && (table.dataset.teamIds ?? '').split(',').includes(team));
      tables.forEach((table) => { const relevant = table === preferred; table.hidden = !relevant; if (relevant) { shown = true; if (heading) { const competition = table.querySelector('caption')?.textContent?.replace(' standings', ''); heading.textContent = competition ? `${competition} table` : 'League table'; } } });
      if (empty) { empty.hidden = shown; empty.textContent = team === 'all' ? 'Select a team to see its current league table.' : 'No published league table is available for this team.'; }
      if (live) live.textContent = `${visibleItems.length} matches shown. Last match followed by next match.`;
    };
    const moveCarousel = (direction: -1 | 1) => {
      if (!carousel) return;
      const visibleItems = items.filter((item) => !item.hidden);
      const currentCentre = carousel.scrollLeft + carousel.clientWidth / 2;
      const currentIndex = visibleItems.reduce((closest, item, index) => {
        const itemCentre = item.offsetLeft + item.offsetWidth / 2;
        const closestCentre = visibleItems[closest]?.offsetLeft + (visibleItems[closest]?.offsetWidth ?? 0) / 2;
        return Math.abs(itemCentre - currentCentre) < Math.abs(closestCentre - currentCentre) ? index : closest;
      }, 0);
      const target = visibleItems[Math.max(0, Math.min(visibleItems.length - 1, currentIndex + direction))];
      if (target) carousel.scrollTo({ left: Math.max(0, target.offsetLeft - (carousel.clientWidth - target.offsetWidth) / 2), behavior: 'smooth' });
    };
    filter?.addEventListener('change', () => reset('smooth'));
    document.querySelector('[data-carousel-prev]')?.addEventListener('click', () => moveCarousel(-1));
    document.querySelector('[data-carousel-next]')?.addEventListener('click', () => moveCarousel(1));
    document.querySelector('[data-refresh]')?.addEventListener('click', () => { reset('auto'); if (live) live.textContent = `${filter?.selectedOptions[0]?.textContent?.trim() || 'All teams'} refreshed and returned to the last match.`; });
    reset('auto');
  </script>
</Layout>

<style>
  .fai-toolbar{display:grid;grid-template-columns:auto minmax(12rem,18rem) 1fr auto;align-items:center;gap:.75rem;margin-bottom:2rem;padding:1rem;border:1px solid var(--card-border);border-radius:var(--card-radius);background:white;box-shadow:var(--card-shadow)}
  .fai-toolbar label{font-weight:650;color:var(--brand-navy)} .fai-toolbar p{justify-self:end;margin:0;color:var(--muted);font-size:.8rem}.fai-refresh svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-width:2}
  .carousel-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1rem}.carousel-heading :where(p,h2){margin:0}
  .match-carousel{display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - 2rem)/3);align-items:stretch;gap:1rem;overflow-x:auto;padding:.2rem .1rem 1.5rem;scroll-snap-type:x mandatory;scrollbar-width:thin}.match-carousel__item{display:flex;min-width:0;align-self:stretch;scroll-snap-align:start}.match-carousel__item[hidden]{display:none}.match-carousel__spacer{display:block;min-width:0;pointer-events:none}.match-carousel__item :global(.fixture-card){width:100%;height:100%}.table-empty{padding:1.5rem;color:var(--muted)}
  @media(max-width:900px){.match-carousel{grid-auto-columns:calc((100% - 1rem)/2)}} @media(max-width:640px){.fai-toolbar{grid-template-columns:1fr auto}.fai-toolbar label,.fai-toolbar select{grid-column:1/-1}.fai-toolbar p{justify-self:start}.match-carousel{grid-auto-columns:92%}}
</style>
