---
import FixtureTabletRow from '../components/FixtureTabletRow.astro';
import FixtureMobileCard from '../components/FixtureMobileCard.astro';
import PageHeader from '../components/PageHeader.astro';
import PagePanel from '../components/PagePanel.astro';
import LeagueTableHeader from '../components/LeagueTableHeader.astro';
import Layout from '../layouts/Layout.astro';
import { readFaiSnapshot } from '../lib/fai/data';
import { getCurrentLeagueTables, getTeamFilterOptions, teamFilterLabel } from '../lib/fai/tables';
import { withBase } from '../utils/paths';
import { hasRoundTeamCrest, localCrestForTeam } from '../utils/teamCrests';
import { RefreshCw } from '@lucide/astro';

const data = await readFaiSnapshot();
const matches = data.matches
  .map((match) => ({ ...match, status: Date.parse(match.date) > Date.now() ? 'future' as const : 'past' as const }))
  .sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
const formatDate = (value: string) => new Intl.DateTimeFormat('en-IE', { timeZone: 'Europe/Dublin', weekday: 'short', month: 'short', day: 'numeric' }).format(new Date(value));
const formatTime = (value: string) => new Intl.DateTimeFormat('en-IE', { timeZone: 'Europe/Dublin', hour: 'numeric', minute: '2-digit', hour12: true }).format(new Date(value)).replace('a.m.', 'am').replace('p.m.', 'pm');
const displayClubName = (value: string) => {
  if (/^Killarney Athletic AFC\b/i.test(value)) {
    const squad = value.match(/\b(Senior\s+[AB]|U\d{2}[A-Z]?)\b/i)?.[1];
    const squadLabel = squad?.match(/[AB]$/i)?.[0].toUpperCase();
    return `Killarney Athletic A.F.C.${squadLabel ? ` ${squadLabel}` : ''}`;
  }
  return value
    .replace(/\s+Senior\s+([AB])\b/i, ' $1')
    .replace(/\s+(?:Men|Mens|Women's|Women|Boys|Girls)\s+([AB])\b/i, ' $1')
    .replace(/\s+([AB])\s+Team\b/i, ' $1')
    .replace(/\s+KRYDL(?:\s+Premier A)?$/i, '')
    .replace(/\s+KDL\s+([AB])$/i, ' $1')
    .replace(/\s+(?:\d{2}\/\d{2}|20\d{2}\/\d{2}|20\d{2}-20\d{2})(?:\s+season)?$/i, '')
    .trim();
};
const displayCrestUrl = (club: string, crestUrl: string | null) => localCrestForTeam(club) ?? crestUrl;
const updatedAt = new Intl.DateTimeFormat('en-IE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Dublin' }).format(new Date(data.sourceUpdatedAt));
const currentLeagueTables = getCurrentLeagueTables(data.teams, data.tables, data.matches);
const teamFilterOptions = getTeamFilterOptions(data.teams);
---

<Layout title="Fixtures & Results | Killarney Athletic A.F.C." description="Track match schedules, league tables, and cup tournament scorelines across all senior and underage competitive squads." canonicalPath="/fixtures-results/">
  <article class="page-shell page-template page-template--data fixtures-results-page">
    <PageHeader title="Fixtures & Results" intro="Fixtures, results and league information across Killarney Athletic A.F.C." breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Fixtures & Results' }]} />
    <p class="sr-only" aria-live="polite" data-live></p>
    <section class="match-section" aria-label="Results and fixtures">
      <PagePanel class="match-list-panel" flush>
        <div class="fixture-preview-panel__toolbar">
          <label for="fixtures-team-filter">Filter by team</label>
          <select id="fixtures-team-filter" class="select select-bordered select-sm" data-team-filter><option value="all">All teams</option>{teamFilterOptions.map((team) => <option value={team.id}>{teamFilterLabel(team)}</option>)}</select>
          <div class="fixture-preview-panel__toolbar-meta">
            <p>{data.isFallback ? 'Showing the latest saved update' : `Updated ${updatedAt}`}</p>
            <button class="btn btn-ghost btn-sm fixture-preview-refresh" type="button" data-refresh><RefreshCw aria-hidden="true" size={16} stroke-width={1.9} /> Refresh</button>
          </div>
        </div>
        <div class="fixture-tablet-list"><div class="fixture-desktop-header" aria-hidden="true"><span>Competition</span><span>Teams</span><span>Score</span><span>Result</span><span>Venue</span><span>Details</span></div>{matches.map((match) => <FixtureTabletRow id={match.id} teamId={match.teamId} teamLabel={match.teamLabel} status={match.status} dateValue={match.date} date={formatDate(match.date)} time={formatTime(match.date)} venue={match.venue} homeTeam={match.homeTeam} awayTeam={match.awayTeam} homeCrest={match.homeCrest} awayCrest={match.awayCrest} score={match.score} competition={match.competition} />)}{!matches.length && <p class="match-list__empty">No match information is currently available.</p>}</div>
        <div class="fixture-mobile-list">{matches.map((match) => <FixtureMobileCard id={match.id} teamId={match.teamId} teamLabel={match.teamLabel} status={match.status} dateValue={match.date} date={formatDate(match.date)} time={formatTime(match.date)} venue={match.venue} homeTeam={match.homeTeam} awayTeam={match.awayTeam} homeCrest={match.homeCrest} awayCrest={match.awayCrest} score={match.score} competition={match.competition} />)}{!matches.length && <p class="match-list__empty">No match information is currently available.</p>}</div>
      </PagePanel>
    </section>
    <section class="league-table-section" aria-labelledby="league-table-heading">
      <PagePanel class="league-table-shell" flush>
        <LeagueTableHeader slot="header" dynamic />
        <div class="overflow-x-auto">
          {Array.from(currentLeagueTables.entries()).map(([teamId, table]) => <table class="table table-zebra league-table" data-table data-team-id={teamId} hidden><caption class="sr-only">{table.competition} standings</caption><thead><tr><th>Pos</th><th>Club</th><th>P</th><th>W</th><th>D</th><th>L</th><th>GF</th><th>GA</th><th>GD</th><th>Pts</th></tr></thead><tbody>{table.rows.map((row) => <tr class:list={{ 'league-table__club-row': row.isKillarneyAthletic }}><td>{row.position}</td><th scope="row"><span class="league-table__club">{displayCrestUrl(row.club, row.crestUrl) ? <img class:list={{ 'club-crest--round': hasRoundTeamCrest(row.club) }} src={withBase(displayCrestUrl(row.club, row.crestUrl)!)} alt="" width="28" height="28" loading="lazy" /> : <span class="league-table__crest-placeholder"></span>}<span>{displayClubName(row.club)}</span></span></th><td>{row.played}</td><td>{row.won}</td><td>{row.drawn}</td><td>{row.lost}</td><td>{row.goalsFor}</td><td>{row.goalsAgainst}</td><td>{row.goalDifference}</td><td><strong>{row.points}</strong></td></tr>)}</tbody></table>)}
          <p class="table-empty" data-table-empty>Select a team to see its current league table.</p>
        </div>
      </PagePanel>
    </section>
  </article>
  <script>
    const filter = document.querySelector<HTMLSelectElement>('[data-team-filter]');
    const matchTime = (item: HTMLElement) => Date.parse(item.dataset.date ?? '');
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-match]')).sort((a, b) => {
      const aTime = matchTime(a); const bTime = matchTime(b);
      if (!Number.isFinite(aTime)) return 1;
      if (!Number.isFinite(bTime)) return -1;
      return aTime - bTime;
    });
    const tables = Array.from(document.querySelectorAll<HTMLTableElement>('[data-table]'));
    const empty = document.querySelector<HTMLElement>('[data-table-empty]');
    const heading = document.querySelector<HTMLElement>('[data-table-heading]');
    const live = document.querySelector<HTMLElement>('[data-live]');
    const reset = () => {
      const team = filter?.value ?? 'all';
      items.forEach((item) => item.hidden = team !== 'all' && item.dataset.team !== team);
      items.forEach((item) => { const teamContext = item.querySelector<HTMLElement>('[data-fixture-team-context]'); if (teamContext) teamContext.hidden = team !== 'all'; });
      const visibleItems = items.filter((item) => !item.hidden);
      let shown = false;
      const preferred = tables.find((table) => team !== 'all' && table.dataset.teamId === team);
      tables.forEach((table) => { const relevant = table === preferred; table.hidden = !relevant; if (relevant) { shown = true; if (heading) { const competition = table.querySelector('caption')?.textContent?.replace(' standings', ''); heading.textContent = competition ? `${competition} table` : 'League table'; } } });
      if (!shown && heading) heading.textContent = 'League table';
      if (empty) { empty.hidden = shown; empty.textContent = team === 'all' ? 'Select a team to see its current league table.' : 'No published league table is available for this team.'; }
      if (live) live.textContent = `${visibleItems.filter((item) => item.classList.contains('fixture-tablet-row')).length} matches shown. Fixtures and results across the club.`;
    };
    filter?.addEventListener('change', reset);
    document.querySelector('[data-refresh]')?.addEventListener('click', () => {
      if (filter) filter.value = 'all';
      reset();
      if (live) live.textContent = 'All teams restored.';
    });
    reset();
  </script>
</Layout>

<style>
  :global(.fixture-preview-row[hidden]){display:none}.match-list__empty{margin:0;padding:1.5rem;color:var(--muted)}.table-empty{padding:1.5rem;color:var(--muted)}
</style>
