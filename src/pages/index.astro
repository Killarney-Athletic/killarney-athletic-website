---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import ImageCtaSection from '../components/ImageCtaSection.astro';
import LogoCloud from '../components/LogoCloud.astro';
import HeroSection from '../components/HeroSection.astro';
import NewsCard from '../components/NewsCard.astro';
import FullBleedCarousel from '../components/FullBleedCarousel.astro';
import { getPosts } from '../lib/wordpress';
import { CLUB_LINKS } from '../config/links';
import { isTournamentSeason, tournamentPath } from '../lib/tournament';
import pitchImage from '../assets/images/backgrounds/pitch.jpg';
import summerCampsImage from '../assets/images/backgrounds/SummerCamps.png';
import summerCampLogoUrl from '../assets/images/backgrounds/SummerCampLogo.svg?url';
import joinTheClubImage from '../assets/images/backgrounds/JoinTheClub.png';
import registrationHeroImageUrl from '../assets/images/backgrounds/registration.png?url';
import membershipPlayerImageUrl from '../assets/images/backgrounds/membership.png?url';
import clubCrestWhiteUrl from '../assets/images/brand/crest/svg/Club Crest White.svg?url';
import { withBase } from '../utils/paths';
import ActiveNotices from '../components/ActiveNotices.astro';
import FixtureTabletRow from '../components/FixtureTabletRow.astro';
import FixtureMobileCard from '../components/FixtureMobileCard.astro';
import { readFaiSnapshot } from '../lib/fai/data';
import { RefreshCw } from '@lucide/astro';
import { getTeamFilterOptions, teamFilterLabel } from '../lib/fai/tables';

let clubPosts = [];
const footballBodies = [
  {
    name: 'SFAI',
    href: 'https://sfai.ie/',
    logo: 'https://sfai.ie/wp-content/uploads/2022/07/cropped-SFAI-PNG-2-300x300.png',
    alt: 'Schoolboys Football Association of Ireland logo',
  },
  {
    name: 'FAI',
    href: 'https://www.fai.ie/national-teams/',
    logo: 'https://www.fai.ie/packages/fai_package/themes/fai_theme/images/fai-logo.svg',
    alt: 'Football Association of Ireland logo',
  },
  {
    name: 'Munster Football Association',
    href: 'https://munsterfootball.ie/',
    logo: 'https://munsterfootball.ie/wp-content/uploads/2025/02/Blue-Gold-300x300.png',
    alt: 'Munster Football Association logo',
  },
  {
    name: 'Kerry Schoolboys/Girls League',
    href: 'https://kerryschoolboysgirlsleague.com/',
    logo: 'https://kerryschoolboysgirlsleague.com/wp-content/uploads/2021/09/favicon_logo-300x300.png',
    alt: 'Kerry Schoolboys and Girls League logo',
  },
  {
    name: 'Kerry District League',
    href: 'https://www.facebook.com/KerryDistrictLg/',
    logo: 'https://graph.facebook.com/KerryDistrictLg/picture?type=large',
    alt: 'Kerry District League logo',
  },
];

const allPosts = await getPosts(100);
clubPosts = allPosts.slice(0, 3);
const noticesAwaitingExpiry = allPosts.filter((post) => post.notice && post.notice.expiresAt > new Date());
const tournamentIsActive = isTournamentSeason();
const fixturePreview = [
  {
    squad: 'Senior A',
    home: 'Killarney Athletic',
    homeCrest: '/images/team-crests/killarney-athletic-afc.svg',
    away: 'Tralee Dynamos',
    awayCrest: '/images/team-crests/tralee-dynamos.png',
    date: 'Sun 20 Sep',
    time: '2:00 pm',
    venue: 'Killarney Athletic Park',
  },
  {
    squad: 'U16 Boys',
    home: 'St. Brendan’s Park',
    homeCrest: '/images/team-crests/st-brendans-park-fc.png',
    away: 'Killarney Athletic',
    awayCrest: '/images/team-crests/killarney-athletic-afc.svg',
    date: 'Sat 26 Sep',
    time: '11:00 am',
    venue: 'Christy Leahy Park',
  },
  {
    squad: 'U13 Girls',
    home: 'Killarney Athletic',
    homeCrest: '/images/team-crests/killarney-athletic-afc.svg',
    away: 'Castleisland AFC',
    awayCrest: '/images/team-crests/castleisland-afc.png',
    date: 'Sun 27 Sep',
    time: '10:30 am',
    venue: 'Killarney Athletic Park',
  },
  {
    squad: 'Senior B',
    home: 'Mastergeeha FC',
    homeCrest: '/images/team-crests/mastergeeha-fc.png',
    away: 'Killarney Athletic',
    awayCrest: '/images/team-crests/killarney-athletic-afc.svg',
    date: 'Sun 27 Sep',
    time: '2:30 pm',
    venue: 'Kilbrean Park',
  },
  {
    squad: 'U15 Boys',
    home: 'Killarney Athletic',
    homeCrest: '/images/team-crests/killarney-athletic-afc.svg',
    away: 'Killorglin AFC',
    awayCrest: '/images/team-crests/killorglin-afc.png',
    date: 'Sat 3 Oct',
    time: '12:30 pm',
    venue: 'Killarney Athletic Park',
  },
  {
    squad: 'Youths',
    home: 'Classic FC',
    homeCrest: '/images/team-crests/classic-fc.png',
    away: 'Killarney Athletic',
    awayCrest: '/images/team-crests/killarney-athletic-afc.svg',
    date: 'Sun 4 Oct',
    time: '11:00 am',
    venue: 'Mounthawk Park',
  },
  {
    squad: 'U14 Girls',
    home: 'Killarney Athletic',
    homeCrest: '/images/team-crests/killarney-athletic-afc.svg',
    away: 'Listowel Celtic',
    awayCrest: '/images/team-crests/listowel-celtic-afc.png',
    date: 'Sat 10 Oct',
    time: '10:30 am',
    venue: 'Killarney Athletic Park',
  },
  {
    squad: 'U12 Boys',
    home: 'Ballyheigue Athletic',
    homeCrest: '/images/team-crests/ballyheigue-athletic-fc.png',
    away: 'Killarney Athletic',
    awayCrest: '/images/team-crests/killarney-athletic-afc.svg',
    date: 'Sat 10 Oct',
    time: '1:00 pm',
    venue: 'Ballyheigue',
  },
];
const fixturePreviewTeams = [...new Set(fixturePreview.map((fixture) => fixture.squad))];
const faiData = await readFaiSnapshot();
const homeTeamFilterOptions = getTeamFilterOptions(faiData.teams);
const latestResultByTeam = new Map<number, (typeof faiData.matches)[number]>();
for (const match of [...faiData.matches].filter((item) => item.status === 'past' && item.score).sort((a, b) => Date.parse(b.date) - Date.parse(a.date))) {
  if (!latestResultByTeam.has(match.teamId)) latestResultByTeam.set(match.teamId, match);
}
const fixtureTimeline = [...latestResultByTeam.values()].sort((a, b) => Date.parse(b.date) - Date.parse(a.date));
const faiUpdatedAt = new Intl.DateTimeFormat('en-IE', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Europe/Dublin' }).format(new Date(faiData.sourceUpdatedAt));
const formatFixtureDate = (value: string) => new Intl.DateTimeFormat('en-IE', { timeZone: 'Europe/Dublin', weekday: 'short', day: 'numeric', month: 'short' }).format(new Date(value));
const formatFixtureTime = (value: string) => new Intl.DateTimeFormat('en-IE', { timeZone: 'Europe/Dublin', hour: 'numeric', minute: '2-digit', hour12: true }).format(new Date(value)).replace('a.m.', 'am').replace('p.m.', 'pm');
---

<Layout
  title="Killarney Athletic A.F.C. | Official Website"
  description="Official Killarney Athletic A.F.C. channel. Fixtures, results, club news, academy registrations, online club shop, and community events from Woodlawn."
  canonicalPath="/"
>
  <HeroSection
    variant="registration"
    eyebrow="Registration open · 2026/27"
    title={'Join\u00A0Killarney Athletic\u00A0A.F.C.'}
    background={registrationHeroImageUrl}
    overlayImage={membershipPlayerImageUrl}
  >
    <Fragment slot="intro">Registrations are now <strong>open for the 2026/27 season</strong> for our youngest Academy players through to Youth and Senior teams.</Fragment>
    <Fragment slot="actions">
      <Button
        href={CLUB_LINKS.clubforce.membership}
        label="Register for 2026/27"
        size="md"
        variant="primary"
        target="_blank"
        rel="noopener noreferrer"
      />
    </Fragment>
  </HeroSection>

  <ActiveNotices notices={noticesAwaitingExpiry} />

  {tournamentIsActive && (
    <section class="seasonal-tournament-promo" aria-labelledby="seasonal-tournament-heading">
      <div class="page-shell seasonal-tournament-promo__inner">
        <div>
          <p class="eyebrow">June–early July · Woodlawn</p>
          <h2 id="seasonal-tournament-heading">Killarney Credit Union 7-A-Side Tournament</h2>
          <p>Find current tournament dates, entry information, fixtures and updates.</p>
        </div>
        <Button href={withBase(tournamentPath)} label="Tournament information" variant="light" />
      </div>
    </section>
  )}

  <section id="fixtures" class="fixtures-section section-block" aria-labelledby="fixtures-heading">
    <div class="page-shell">
      <div class="section-heading">
        <div>
          <h2 id="fixtures-heading">Results</h2>
        </div>
        <p class="section-note">Across the club · Live schedule</p>
      </div>
      <div class="fixture-preview-panel">
        <div class="fixture-preview-panel__toolbar">
          <label for="fixture-team-filter">Filter by team</label>
          <select id="fixture-team-filter" class="select select-bordered select-sm" data-fixture-team-filter>
            <option value="all">All teams</option>
            {homeTeamFilterOptions.map((team) => <option value={team.id}>{teamFilterLabel(team)}</option>)}
          </select>
          <div class="fixture-preview-panel__toolbar-meta">
            <p>Updated {faiUpdatedAt}</p>
            <button class="btn btn-ghost btn-sm fixture-preview-refresh" type="button" data-fixture-refresh><RefreshCw aria-hidden="true" size={16} stroke-width={1.9} /> Refresh</button>
          </div>
        </div>
        <div class="fixture-tablet-list"><div class="fixture-desktop-header" aria-hidden="true"><span>Competition</span><span>Teams</span><span>Score</span><span>Result</span><span>Venue</span><span>Details</span></div>{fixtureTimeline.map((fixture) => <FixtureTabletRow id={fixture.id} teamId={fixture.teamId} teamLabel={fixture.teamLabel} status={fixture.status} dateValue={fixture.date} date={formatFixtureDate(fixture.date)} time={formatFixtureTime(fixture.date)} venue={fixture.venue} homeTeam={fixture.homeTeam} awayTeam={fixture.awayTeam} homeCrest={fixture.homeCrest} awayCrest={fixture.awayCrest} score={fixture.score} competition={fixture.competition} />)}</div>
        <div class="fixture-mobile-list">{fixtureTimeline.map((fixture) => <FixtureMobileCard id={fixture.id} teamId={fixture.teamId} teamLabel={fixture.teamLabel} status={fixture.status} dateValue={fixture.date} date={formatFixtureDate(fixture.date)} time={formatFixtureTime(fixture.date)} venue={fixture.venue} homeTeam={fixture.homeTeam} awayTeam={fixture.awayTeam} homeCrest={fixture.homeCrest} awayCrest={fixture.awayCrest} score={fixture.score} competition={fixture.competition} />)}</div>
        <div class="fixture-preview-panel__footer">
          <Button href={withBase('/fixtures-results/')} label="View all fixtures & results" variant="outline-dark" />
        </div>
      </div>
    </div>
  </section>

  <script>
    const fixtureFilter = document.querySelector<HTMLSelectElement>('[data-fixture-team-filter]');
    const fixtureRows = Array.from(document.querySelectorAll<HTMLElement>('[data-fixture-row]'));

    const renderFixturePreview = () => {
      const selectedTeam = fixtureFilter?.value ?? 'all';
      const matches = fixtureRows.filter((row) => selectedTeam === 'all' || row.dataset.team === selectedTeam);
      fixtureRows.forEach((row) => {
        row.hidden = !matches.includes(row);
        const teamContext = row.querySelector<HTMLElement>('[data-fixture-team-context]');
        if (teamContext) teamContext.hidden = selectedTeam !== 'all';
      });
    };

    fixtureFilter?.addEventListener('change', renderFixturePreview);
    document.querySelector('[data-fixture-refresh]')?.addEventListener('click', () => {
      if (fixtureFilter) fixtureFilter.value = 'all';
      renderFixturePreview();
    });
    renderFixturePreview();
  </script>

  <section id="news" class="page-shell section-block news-section" aria-label="Club news">
    <FullBleedCarousel label="Latest club news">
        {clubPosts.map((post) => {
          const isSummerCamp = /summer\s+camp/i.test(post.title);
          const isThreeHundredClub = /300\s+club/i.test(post.title);
          return (
            <NewsCard
              class="full-bleed-carousel__item"
              title={post.title}
              href={withBase(`/news/${post.slug}/`)}
              excerpt={post.excerpt}
              category={post.categories[0]?.name}
              date={post.date}
              featuredImageUrl={post.featuredImageUrl}
              featuredImageAlt={post.featuredImageAlt}
              fallbackImage={isSummerCamp ? summerCampsImage : pitchImage}
              fallbackLogoUrl={summerCampLogoUrl}
              crestUrl={clubCrestWhiteUrl}
              treatment={isSummerCamp ? 'summer-camp' : isThreeHundredClub ? 'three-hundred-club' : 'default'}
            />
          );
        })}
    </FullBleedCarousel>
  </section>

  <LogoCloud
    title="Connected through"
    accentTitle="Irish Football"
    description="Killarney Athletic is part of a wider football community across "
    descriptionAccent="Kerry, Munster and Ireland."
    items={footballBodies}
  />

  <ImageCtaSection
    id="membership"
    layout="hero"
    eyebrow="Be part of the club"
    title="Membership and registration"
    description="Register online through the club’s official Clubforce membership page."
    buttonLabel="Join the Club"
    href={CLUB_LINKS.clubforce.membership}
    target="_blank"
    rel="noopener noreferrer"
    background={joinTheClubImage}
  />
</Layout>
