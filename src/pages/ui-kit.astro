  <script>
    const searchInput = document.querySelector('[data-ui-kit-search]');
    const searchResult = document.querySelector('[data-ui-kit-search-result]');
    const searchableSections = Array.from(document.querySelectorAll('.ui-kit-section, .logo-cloud, .image-cta-section'));
    const inventorySection = document.querySelector('[data-ui-kit-inventory-section]');
    const inventoryGroups = Array.from(document.querySelectorAll('[data-ui-kit-inventory-group]'));
    const inventoryItems = Array.from(document.querySelectorAll('[data-ui-kit-inventory-item]'));

    const getSectionLabel = (section) => {
      const heading = section.querySelector('h2, h3');
      return heading?.textContent?.trim() || 'section';
    };

    const filterInventory = (query) => {
      if (!inventoryItems.length) return;

      inventoryItems.forEach((item) => {
        const searchableText = item.getAttribute('data-ui-kit-search-text')?.toLowerCase() || item.textContent?.toLowerCase() || '';
        item.hidden = Boolean(query) && !searchableText.includes(query);
      });

      inventoryGroups.forEach((group) => {
        const visibleItems = Array.from(group.querySelectorAll('[data-ui-kit-inventory-item]')).filter((item) => !item.hidden);
        group.hidden = Boolean(query) && visibleItems.length === 0;
      });
    };

    const filterUiKit = () => {
      const query = searchInput?.value.trim().toLowerCase() || '';
      let visibleCount = 0;

      filterInventory(query);
      if (inventorySection) {
        inventorySection.hidden = Boolean(query);
      }

      searchableSections.forEach((section) => {
        if (section === inventorySection) {
          if (!section.hidden) visibleCount += 1;
          return;
        }

        const searchableText = section.textContent?.toLowerCase() || '';
        const visibleInventoryGroups = section.querySelectorAll('[data-ui-kit-inventory-group]:not([hidden])').length;
        const isComponentInventory = section.querySelector('[data-ui-kit-inventory-group]');
        const isVisible = !query || searchableText.includes(query) || (Boolean(isComponentInventory) && visibleInventoryGroups > 0);
        section.hidden = !isVisible;
        if (isVisible) visibleCount += 1;
      });

      if (!searchResult) return;

      if (!query) {
        searchResult.textContent = '';
        return;
      }

      const label = visibleCount === 1 ? getSectionLabel(searchableSections.find((section) => !section.hidden)) : `${visibleCount} sections`;
      searchResult.textContent = visibleCount ? `Showing ${label}` : 'No UI Kit sections match that search.';
    };

    searchInput?.addEventListener('input', filterUiKit);
  </script>
