---
import Layout from '../../layouts/Layout.astro';
import { Share2 } from '@lucide/astro';
import PageHeader from '../../components/PageHeader.astro';
import ContentBadge from '../../components/ContentBadge.astro';
import { getPostPaths } from '../../lib/wordpress';
import type { WPPost } from '../../utils/wpParser';
import { CLUB_LINKS } from '../../config/links';

export async function getStaticPaths() {
  return getPostPaths(100);
}

const { post } = Astro.props as { post: WPPost };
const postUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://www.killarneyathletic.com');
---

<Layout title={`${post.title} | Killarney Athletic AFC`} description={post.excerpt}>
  <article class="notice-page page-shell">
    <PageHeader
      title={post.title}
      breadcrumbs={[
        { label: 'Home', href: '/' },
        { label: 'News', href: '/news/' },
        { label: post.title },
      ]}
    >
      <div slot="meta" class="meta-row">
        {post.categories[0] && <ContentBadge label={post.categories[0].name} />}
        <time datetime={post.date.toISOString()}>
          {post.date.toLocaleDateString('en-IE', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      </div>
    </PageHeader>

    <div class="notice-page__content" set:html={post.content} />

    <footer class="notice-page__share" aria-label="Share this news post">
      <p>Share this update</p>
      <div class="notice-page__share-links">
        <a
          href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(postUrl.href)}`}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Share this post on Facebook"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14.2 8.3V6.9c0-.7.5-1.1 1.2-1.1h1.5V3.2c-.7-.1-1.5-.2-2.3-.2-2.3 0-3.9 1.4-3.9 3.8v1.5H8.1v2.9h2.6V21h3.2v-9.8h2.6l.4-2.9h-2.7Z" />
          </svg>
          <span>Facebook</span>
        </a>
        <a
          href={CLUB_LINKS.socials.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open Killarney Athletic AFC on Instagram"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M7.8 2.8h8.4c2.8 0 5 2.2 5 5v8.4c0 2.8-2.2 5-5 5H7.8c-2.8 0-5-2.2-5-5V7.8c0-2.8 2.2-5 5-5Zm0 2.1c-1.6 0-2.9 1.3-2.9 2.9v8.4c0 1.6 1.3 2.9 2.9 2.9h8.4c1.6 0 2.9-1.3 2.9-2.9V7.8c0-1.6-1.3-2.9-2.9-2.9H7.8Zm4.2 3.2a3.9 3.9 0 1 1 0 7.8 3.9 3.9 0 0 1 0-7.8Zm0 2.1a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6Zm4.1-2.4a1.1 1.1 0 1 1 2.2 0 1.1 1.1 0 0 1-2.2 0Z" />
          </svg>
          <span>Instagram</span>
        </a>
        <button class="notice-page__share-button" type="button" data-share-title={post.title}>
          <Share2 aria-hidden="true" size={18} stroke-width={2.25} />
          <span>Share link</span>
        </button>
      </div>
    </footer>
  </article>

  <script>
    const shareButton = document.querySelector<HTMLButtonElement>('.notice-page__share-button');

    shareButton?.addEventListener('click', async () => {
      const title = shareButton.dataset.shareTitle ?? document.title;
      const url = window.location.href;

      if (navigator.share) {
        await navigator.share({ title, url });
        return;
      }

      await navigator.clipboard?.writeText(url);
      const label = shareButton.querySelector('span');
      if (!label) return;
      const originalLabel = label.textContent;
      label.textContent = 'Copied';
      window.setTimeout(() => {
        label.textContent = originalLabel;
      }, 1800);
    });
  </script>
</Layout>
